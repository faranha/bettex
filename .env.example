# Copy to .env outside Replit; never commit the populated file.
# Replit managed workflows already supply their own PORT and BASE_PATH.
NODE_ENV=development
BASE_PATH=/
SITE_PORT=5173
API_PORT=8080
LOCAL_EVM_PORT=3001

# A fresh DEVELOPMENT database only. Supply credentials through a secret manager.
DATABASE_URL=

# Public site builds work without Clerk. Clerk account features require a tenant.
# Native test accounts are development-only and do not replace production auth.
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SESSION_SECRET=

# Local EVM only; this must never be a mainnet or public-provider endpoint.
BETTEX_LOCAL_FIXTURE_URL=http://127.0.0.1:3001
BETTEX_EXECUTION_PAUSED=true
LOG_LEVEL=info
