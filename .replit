modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pitch-research"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "bettex-local-evm"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "github-sync"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "bettex-public-testnet"

[[workflows.workflow]]
name = "pitch-research"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/bettex-site run check:pitch-research"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "bettex-local-evm"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/bettex-contracts run local:runtime"

[[workflows.workflow]]
name = "github-sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm sync:watch"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "bettex-public-testnet"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BETTEX_TESTNET_ACTIVITY_URL=http://127.0.0.1:8080/api/demo/testnet-activity pnpm --filter @workspace/bettex-contracts run public:runtime"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 25336
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BETTEX_PUBLIC_DEMO_OPERATOR_ADDRESS = "0x078E12110CF7b7C33de6fd59dBa4C240f8ED3F56"
BETTEX_PUBLIC_DEMO_CONTRACT_ADDRESS = "0x111903a2F5DCefe434f0e14EeD3FFA2f383Cc4C8"
