modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pitch-research"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "bettex-local-evm"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "github-sync"

[[workflows.workflow]]
name = "pitch-research"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/bettex-site run check:pitch-research"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "bettex-local-evm"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/bettex-contracts run local:runtime"

[[workflows.workflow]]
name = "github-sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm sync:watch"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 25336
externalPort = 80

[nix]
channel = "stable-25_05"
