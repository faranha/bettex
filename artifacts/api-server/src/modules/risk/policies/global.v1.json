{
  "id": "prediction-simulation-policy",
  "version": 1,
  "type": "treasury",
  "scope": "global",
  "schemaVersion": 1,
  "name": "Controles globais da Tesouraria para simulação",
  "implementation": "treasury-paper-controls/1",
  "justification": "Limites técnicos conservadores exclusivamente simulados. Não são parâmetros econômicos aprovados, não financiam o subledger nem autorizam dinheiro real.",
  "previousVersion": null,
  "openPositions": "preserve_original_exit_and_apply_emergency_controls",
  "controls": {
    "mode": "simulation_only",
    "paused": false,
    "maxOrderUnits": "250000000",
    "maxCorrelatedUnits": "250000000",
    "maxPortfolioUnits": "500000000",
    "defensiveUnits": "500000000",
    "maxAssetUnits": "250000000",
    "maxEventUnits": "250000000",
    "maxStrategyUnits": "500000000",
    "maxCounterpartyUnits": "500000000",
    "maxQuoteAgeSeconds": 60,
    "maxSourceAgeSeconds": 120,
    "maxHorizonSeconds": 86400,
    "maxAttempts": 3,
    "retrySeconds": 30,
    "minimumNetEdgeBps": 300,
    "exitHysteresisBps": 200,
    "reentryCooldownSeconds": 600,
    "maximumHoldSeconds": 86400,
    "maximumLossBps": 1500,
    "allowedAssets": ["btc", "eth", "sol"],
    "allowedProviders": ["polymarket_gamma_clob"],
    "allowedMarkets": ["prediction"],
    "requireCalibratedModel": true,
    "requireCompleteCosts": true,
    "requireExitPlan": true,
    "requireReconciliation": true
  }
}
