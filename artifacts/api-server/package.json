{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:reasoning": "node --test scripts/agent-reasoning.test.mjs",
    "check:agents": "node --test scripts/alpha-hierarchy.test.mjs",
    "check:allora": "node --test scripts/allora-public.test.mjs",
    "check:agent-operations": "node --test scripts/agent-operations.test.mjs",
    "check:paper": "node --test scripts/paper-trading.test.mjs",
    "check:trading-policies": "node --test scripts/trading-policy.test.mjs",
    "check:treasury": "node --test scripts/treasury-governance.test.mjs",
    "check:treasury-integration": "node scripts/treasury-governance-integration.mjs",
    "check:history": "node --test scripts/history.test.mjs",
    "check:history-store": "node scripts/history-store-integration.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:demo": "node --test scripts/demo-state.test.mjs scripts/orchestrator.test.mjs scripts/treasury-round.test.mjs scripts/staking-timeline.test.mjs scripts/scheduled-demo-story.test.mjs scripts/earnings-wallet.test.mjs",
    "check:accounts": "node --test scripts/personal-accounts.test.mjs scripts/nickname.test.mjs",
    "check:journey": "node --test scripts/native-journey.test.mjs scripts/local-round.test.mjs",
    "check:security": "node --test scripts/http-security.test.mjs && node scripts/security-isolation.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.75",
    "@clerk/shared": "^4.38.0",
    "@google-cloud/storage": "^8.2.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/bettex-contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "ethers": "6.17.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
