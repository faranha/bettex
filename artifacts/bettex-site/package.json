{
  "name": "@workspace/bettex-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node --test scripts/locale-bootstrap.test.mjs && node scripts/check-demo-locales.mjs && node scripts/check-locales.mjs && node scripts/check-round-policy.mjs && node scripts/check-profit-allocation.mjs && node scripts/check-documentation.mjs && node scripts/check-documentation-navigation.mjs && node scripts/check-documentation-update.mjs && node scripts/check-documentation-runtime.mjs && python scripts/test_pitch_narrative.py && python scripts/localize-downloads.py && vite build --config vite.config.ts && node scripts/prerender.mjs && python scripts/verify-localized-html.py && python scripts/verify-documentation-html.py && python scripts/check-founder-privacy.py",
    "check:demo": "node scripts/check-demo-locales.mjs && node --test src/components/demo/model.test.ts src/components/demo/demo-session.test.ts src/components/demo/personal-native.test.ts src/components/demo/mobile-area-nav.test.ts src/components/demo/demo-navigation.test.ts src/components/demo/staking-model.test.ts src/components/demo/staking-minute-chart.test.ts src/components/demo/previous-cycle.test.ts src/components/history/wallet-history.test.ts src/components/history/history-selection.test.ts src/components/app/exchange-rates.test.ts src/components/account/wallet-key-row.test.ts src/lib/round-terminology.test.ts src/components/history/round-history-selection.test.ts",
    "check:wallets": "node --test scripts/personal-wallets.test.mjs",
    "check:burn-analytics": "node --test src/components/demo/burn-analytics.test.ts",
    "check:allocation": "node scripts/extract-locales.mjs && node scripts/check-profit-allocation.mjs",
    "check:rounds": "node scripts/check-round-policy.mjs",
    "check:docs": "node scripts/check-documentation.mjs && node scripts/check-documentation-navigation.mjs && node scripts/check-documentation-aliases.mjs && node scripts/check-documentation-update.mjs",
    "check:editorial": "node scripts/check-documentation-aliases.mjs && python ../../scripts/check-editorial-revision.py",
    "check:locales": "node scripts/check-locales.mjs && node --test scripts/shared-locale-copy.test.mjs",
    "check:locale-entry": "node --test scripts/locale-bootstrap.test.mjs",
    "check:pitch": "python scripts/test_pitch_narrative.py && python scripts/verify_pitch_narrative.py",
    "check:pitch-research": "node scripts/check-pitch-research.mjs",
    "check:pitch-sliders": "node scripts/check-pitch-sliders.mjs",
    "check:launch": "node --test src/components/pitch/launchSimulation.test.ts",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:community": "node scripts/check-community-copy.mjs && node scripts/check-defi-narrative.mjs",
    "serve": "node scripts/serve.mjs",
    "check:server": "node --test scripts/serve.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
