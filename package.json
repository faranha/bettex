{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "quality": "node scripts/validate-development.mjs",
    "lint": "eslint artifacts/api-server/src artifacts/bettex-site/src scripts --quiet",
    "check:secrets": "python scripts/check-secrets.py",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:security": "pnpm lint && pnpm check:secrets && pnpm check:dependencies && pnpm --filter @workspace/api-server run check:security",
    "check:architecture": "node scripts/check-architecture.mjs && node --test scripts/check-architecture.test.mjs",
    "docs:sync": "python tools/technical-docs/cli.py sync",
    "docs:query": "python tools/technical-docs/cli.py query",
    "docs:status": "python tools/technical-docs/cli.py status",
    "docs:inventory": "python tools/technical-docs/cli.py inventory",
    "docs:changes": "python tools/technical-docs/cli.py changes",
    "check:technical-docs": "python -m unittest discover -s tools/technical-docs/tests -v"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.71.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
